# Copy to .env and fill in. .env is gitignored; this file is not, so
# never put a real value here.

# --- Required ---------------------------------------------------------

# Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/porchlight
# Local: mongodb://127.0.0.1:27017/porchlight
MONGODB_URI=

# Signs user session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out, which is also how you force that.
JWT_SECRET=

# --- Optional ---------------------------------------------------------

# The API and the signaling WebSocket share this port.
PORT=4000

# Browser origin allowed by CORS - the Vite dev server by default.
# Devices are not browsers and are unaffected by this.
CLIENT_ORIGIN=http://localhost:5173

# --- Clip storage: Cloudflare R2 --------------------------------------
#
# Clips go straight from the doorbell to the bucket via a short-lived
# pre-signed PUT, and from the bucket to the viewer via a short-lived
# signed GET. The server only ever moves JSON - it never carries a byte
# of video, which is the same rule that keeps it out of the live media
# path.
#
# Create these at dash.cloudflare.com -> R2 -> Manage R2 API Tokens.
# Use an "Object Read & Write" token scoped to this one bucket, not an
# account-wide admin token. The secret is shown exactly once.
#
# Leave blank until the bucket exists: clip endpoints will report that
# storage is not configured, and everything else runs normally.

# 32-char hex, shown on the R2 overview page. The S3 endpoint is
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com and is derived, not set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=porchlight-clips

# --- Live video and talk: LiveKit Cloud -------------------------------
#
# The app server mints access tokens and is never in the media path: the
# Pi publishes one stream to LiveKit and LiveKit copies it out to each
# viewer. Both ends connect outward, so no home router has to accept an
# incoming connection.
#
# From cloud.livekit.io -> your project -> Settings -> Keys. The key and
# secret never leave the server - they sign tokens locally, with no call
# to LiveKit. LIVEKIT_URL is handed to clients so they know where to
# connect.
#
# Leave blank until you have a project: the live-view endpoints report
# that media is not configured, and everything else runs normally.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
